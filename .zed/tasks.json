[
  {
    "label": "Dev: veganmage-web",
    "command": "$HOME/.local/bin/zed-bun",
    "args": [
      "exec",
      "--totalPorts",
      "1",
      "--startPort",
      "5173",
      "$ZED_WORKTREE_ROOT",
      "--",
      "bun",
      "run",
      "dev",
      "--",
      "--host",
      "0.0.0.0"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "Check: lint",
    "command": "$HOME/.local/bin/zed-bun",
    "args": ["exec", "$ZED_WORKTREE_ROOT", "--", "bun", "run", "lint"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "save": "all"
  },
  {
    "label": "Check: types",
    "command": "$HOME/.local/bin/zed-bun",
    "args": [
      "exec",
      "$ZED_WORKTREE_ROOT",
      "--",
      "bun",
      "run",
      "typecheck"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "save": "all"
  },
  {
    "label": "Build: production web",
    "command": "$HOME/.local/bin/zed-bun",
    "args": [
      "build-prod",
      "$ZED_WORKTREE_ROOT",
      "--",
      "bun",
      "run",
      "build"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "show_command": false,
    "save": "all"
  },
  {
    "label": "Preview: production web",
    "command": "$HOME/.local/bin/zed-bun",
    "args": [
      "exec",
      "--totalPorts",
      "1",
      "--startPort",
      "4173",
      "$ZED_WORKTREE_ROOT",
      "--",
      "bun",
      "run",
      "preview",
      "--",
      "--host",
      "0.0.0.0"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "Install: Bun",
    "command": "$HOME/.local/bin/zed-bun",
    "args": ["exec", "$ZED_WORKTREE_ROOT", "--", "bun", "install"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  }
]
